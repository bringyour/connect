# Rig environment. Copy to a private file outside the repository (for example ~/.rig.env), fill in the
# real values and `source` it before running anything in rig/. None of these values may be committed:
# CODESTYLE.md forbids production identities, hostnames and addresses in the tree, so every script and
# document here refers to the placeholders below instead.

# The three physical hosts and the relay. Addresses only; every script uses root@$HOST over ssh with
# BatchMode=yes, so install your key on each host first.
export PROVIDER_HOST=            # provider VPS; runs urprovider as a systemd unit and zerohttp.py (synthetic origin)
export CLIENT_HOST=              # near client, same datacenter as the provider (~0.3 ms network RTT)
export FAR_CLIENT_HOST=          # far client (~100 ms from the provider); runs sink.py for upload tests
export RELAY_HOST=               # the shared beta relay (the host behind connect.$PLATFORM_DOMAIN). READ-ONLY: cpuwin.sh only

# Platform. API is https://api.$PLATFORM_DOMAIN, the H1 websocket relay is wss://connect.$PLATFORM_DOMAIN.
export PLATFORM_DOMAIN=          # beta platform domain (also the relay's DNS name)
export PRODUCTION_DOMAIN=        # production platform domain; only referenced in the ledger's DNS notes, never dialed by the rig

# Identities and credentials.
export PROVIDER_ID=              # client id (UUID) of the rig provider; every client run pins it so no other provider is chosen
export JWT_FILE=                 # path, ON THE HOST THAT RUNS THE SCRIPT, of the network JWT file the clients authenticate with
# export JWT=                    # optional: the JWT itself, for cleanleaks.sh when it runs on the orchestrator (else it is read
                                 # from $JWT_FILE on $PROVIDER_HOST over ssh)

# Local paths.
export RIG_TMP=                  # directory holding cleanleaks.sh and per-run outputs (defaults to the script directory)
export CDN_IP=                   # resolved address of the public CDN test file used by the `cdn` target of tmeas.sh
